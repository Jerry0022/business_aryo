# Copy to .env.local for local development: cp .env.example .env.local

# Database
# - Local: embedded PGlite (no Docker needed), stored in ./.data
# - Vercel: set automatically by the Neon integration (postgresql://…)
DATABASE_URL=pglite://.data/pglite
# Optional direct (non-pooled) connection used for migrations; falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
# Public origin of the app. Optional on Vercel (derived from VERCEL_* vars).
BETTER_AUTH_URL=http://localhost:3000

# Admin
# Comma-separated list of admin e-mails. These accounts are always admins and protected.
ADMIN_EMAILS=aryo.kontakt@gmail.com
# One-time code required on /einrichten to create the first admin account.
ADMIN_SETUP_TOKEN=dev-setup-token

# Analytics (optional) — PostHog, loaded only after cookie consent. See docs/ANALYTICS.md.
# Leave empty to disable analytics and the cookie banner entirely.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to the EU cloud; set https://us.i.posthog.com for a US project.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Mini-Aryo (KI-Bodenberater) — optional. Without a key the chat shows a contact hint.
# Groq (https://console.groq.com, free developer plan) is used first; Grok by xAI is the fallback.
# Never commit real keys.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# XAI_API_KEY=
# XAI_MODEL=grok-4.3
# Per visitor: 10 questions per hour. All visitors together stay below this share of the
# provider quota (Groq free plan: requests + tokens per minute/day), default 0.8 = 80 %.
# BERATER_QUOTA_SHARE=0.8
# Extra cap on questions of all visitors per UTC day (default 500).
# BERATER_DAILY_LIMIT=500
