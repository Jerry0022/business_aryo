# Copy to .env.local for local development: cp .env.example .env.local

# Database
# - Local: embedded PGlite (no Docker needed), stored in ./.data
# - Vercel: set automatically by the Neon integration (postgresql://…)
DATABASE_URL=pglite://.data/pglite
# Optional direct (non-pooled) connection used for migrations; falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-secret
# Public origin of the app. Optional on Vercel (derived from VERCEL_* vars).
BETTER_AUTH_URL=http://localhost:3000

# Admin
# Comma-separated list of admin e-mails. These accounts are always admins and protected.
ADMIN_EMAILS=aryo.kontakt@gmail.com
# One-time code required on /einrichten to create the first admin account.
ADMIN_SETUP_TOKEN=dev-setup-token

# Mini-Aryo (KI-Bodenberater, Grok by xAI) — optional. Without a key the chat shows a contact hint.
# Create a key at https://console.x.ai → API Keys. Never commit the real key.
# XAI_API_KEY=
# Model (default grok-4.3) and max. questions of all visitors per day (default 500, caps the bill).
# XAI_MODEL=grok-4.3
# BERATER_DAILY_LIMIT=500

# Studio link "Statistik" (admins) → PostHog. Optional project id (PostHog → Settings → Project → ID)
# opens the web analytics directly; the host follows NEXT_PUBLIC_POSTHOG_HOST (EU cloud by default).
# NEXT_PUBLIC_POSTHOG_PROJECT_ID=
